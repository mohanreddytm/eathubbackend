# Keep this file as a template. Put real values only in .env or your hosting settings.
DATABASE_URL=
# Required: at least 32 random bytes. Root npm run setup generates one locally.
JWT_SECRET=
RESTAURANT_TIMEZONE=Asia/Kolkata
NODE_ENV=development
PORT=8000
# Comma-separated additional frontend origins (scheme + hostname + optional port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional CLI account setup; clear these after running the initialization/reset script.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional Razorpay TEST checkout for ONE configured restaurant.
# Never put these variables in the React frontend. Live keys are deliberately rejected.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_RESTAURANT_ID=
RAZORPAY_WEBHOOK_SECRET=
